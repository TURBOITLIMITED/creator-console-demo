{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-api",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "api-telebotcreator.turboit.uk/*", "zone_name": "turboit.uk" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "creator-media" }
  ],
  "ai": { "binding": "AI" },

  // Replies are queued with a delay (20s to 2min, 2 to 3min when the chat is
  // going nowhere) so they land at a human pace without holding the webhook.
  "queues": {
    "producers": [{ "binding": "REPLY_QUEUE", "queue": "creator-replies" }],
    "consumers": [{ "queue": "creator-replies", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3 }]
  },

  // Bigger model for chat: the small one ignored instructions like "answer
  // his question first" once the persona got long. ONE vars object only: a
  // second "vars" key silently wins, and that is how AI_MODEL went missing and
  // every chat ran on the 24B fallback model.
  "vars": {
    "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    // Where "he asked for something off the menu" alerts go. This is the
    // owner's own Telegram user id, and the bot must have been started by them.
    "OWNER_TELEGRAM_ID": "8380225719",
    // Declared on the live worker but NEVER referenced anywhere in the source.
    "DEMO": ""
  },

  // Every minute the Fab poller looks for unread threads on switched-on
  // accounts, up to three answers a run, at any hour. A short floor after a
  // message is first seen keeps replies from landing in seconds.
  "triggers": { "crons": ["* * * * *"] }

  // Secrets (set via `wrangler secret put`, never in this file):
  //   ADMIN_TOKEN          global cross-tenant admin bearer  (see AUDIT: god-token)
  //   MEDIA_SECRET         HMAC key for /m/ signed media URLs (falls back to "dev" if unset!)
  //   SUPABASE_URL         https://xsgvdlgmhuxozjlbjzxy.supabase.co
  //   SUPABASE_ANON_KEY    used ONLY for /auth/v1/user identity checks
  //   SUPABASE_SERVICE_KEY used for ALL table access -> bypasses RLS entirely
  //   DEEPSEEK_API_KEY     optional: when set, chat replies run on deepseek-v4-pro
  //   DEEPSEEK_MODEL       optional: overrides that model id
  //   TELEGRAM_WEBHOOK_SECRET shared secret Telegram echoes in the webhook header
}
